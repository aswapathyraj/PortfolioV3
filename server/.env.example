# Portfolio Control Center — server environment
# Copy to server/.env and fill in real values. Never commit real secrets.

# SQLite (zero-setup development).
DATABASE_URL="file:./dev.db"
# Production: switch the provider in server/prisma/schema.prisma to "postgresql"
# and use a connection string like:
# DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

PORT=4000
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# Change these in any real deployment.
JWT_SECRET="dev-only-secret-change-me"
REFRESH_TOKEN_SECRET="dev-only-refresh-change-me"

# Comma-separated CORS origins accepted in production.
CORS_ORIGIN="http://localhost:5173"

# Cookie hardening. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE="false"

# Storage. Only 'local' is implemented; an S3 provider can be added behind the
# same abstraction.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"

# Seed/owner account (used by `npm run db:setup`).
ADMIN_EMAIL="admin@aswapathyraj.dev"
ADMIN_PASSWORD="developer-admin-2026"
ADMIN_NAME="Aswapathy Raj"

# GitHub. Optional; enables the Developer Activity / GitHub module using the
# unauthenticated public API (no token required, rate limits apply).
GITHUB_USERNAME="aswapathyraj"

# Optional: Web3Forms delivery key used by the CMS inbox.
WEB3FORMS_ACCESS_KEY=""